# --- Database -------------------------------------------------------------
# Neon Postgres. With this unset the app renders lib/mock-session.ts instead.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Privy (email login + embedded Solana wallets) ------------------------
# With NEXT_PUBLIC_PRIVY_APP_ID unset, the front door runs its own timings and
# accepts any six digits. See components/FrontDoor.tsx.
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# --- Solana ---------------------------------------------------------------
# A paid RPC. The public endpoint rate-limits the balance poll and drops
# confirmations under load.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# bs58 secret key. Pays the fee on every stake and every payout; keep it funded.
SPONSOR_SECRET_KEY=""
# 32 bytes, base64. Encrypts every pact vault's private key at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=""

# --- DFlow ----------------------------------------------------------------
DFLOW_TRADE_API_URL="https://dev-quote-api.dflow.net"
DFLOW_API_KEY=""
# Platform fee taken on settlement payouts. PLATFORM_FEE_ACCOUNT must be an
# SPL token account for the collected mint, and must exist before the trade.
PLATFORM_FEE_BPS="0"
PLATFORM_FEE_ACCOUNT=""

# --- Rehearsal ------------------------------------------------------------
# "1" runs the whole money path except the broadcast: the route is priced, the
# member signs, the sponsor co-signs, the guard checks it, and the transaction
# is simulated against live mainnet with signature verification on. It is the
# cheapest test of whether a wallet's signing round-trip leaves the sponsor's
# slot intact -- and it costs nothing. Unset it to move money.
STAKE_DRY_RUN=""

# --- Other services -------------------------------------------------------
ANTHROPIC_API_KEY=""
BLOB_READ_WRITE_TOKEN=""

# --- scripts/spike-sponsored-swap.ts only ---------------------------------
# This script submits a REAL sponsored swap on Solana mainnet and spends funds.
CONFIRM_MAINNET_SPIKE=""
TEST_USER_SECRET_KEY=""
# Must differ from the test user's own wallet -- routing into the user's own
# wallet proves nothing about destinationWallet delivery.
TEST_DESTINATION_WALLET=""
